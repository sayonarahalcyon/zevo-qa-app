# Copy this file to .streamlit/secrets.toml for local runs (that file is
# gitignored — never commit real secrets). On Streamlit Community Cloud,
# paste the equivalent into your app's Settings → Secrets instead.

[supabase]
url = "https://xxxxxxxx.supabase.co"
key = "your-supabase-anon-or-service-key"

[intercom]
access_token = "your-intercom-access-token"

[anthropic]
api_key = "sk-ant-..."   # optional — omit to fall back to plain random sampling

[reviewer_passwords]
"Erwin Bagnol" = "choose-a-password"
"Weng Yee" = "choose-a-password"
"Kristine Lariosa" = "choose-a-password"

# Optional — live backup of every saved QA audit into a separate Google
# Sheet (distinct from the retired sheet imported into Historical Log).
# Omit this whole section and the app just skips the backup silently.
# Setup: Google Cloud Console → create/select a project → enable the
# "Google Sheets API" → IAM & Admin → Service Accounts → create one → Keys
# → Add key → JSON (downloads a file — copy its fields in below) → share
# the target Google Sheet with that service account's client_email as an
# Editor → put the sheet's id (from its URL) below.
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

qa_backup_sheet_id = "the-spreadsheet-id-from-its-url"
